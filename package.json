{
	"name": "obsidian-cloudflare-sync",
	"version": "0.1.6",
	"description": "Real-time collaborative sync for Obsidian using Cloudflare infrastructure",
	"keywords": [],
	"license": "0-BSD",
	"type": "module",
	"main": "main.js",
	"scripts": {
		"dev": "bun --watch build.ts",
		"build": "bun run check && bun build.ts production",
		"check": "tsgo --noEmit",
		"lint": "oxlint src/",
		"lint:fix": "oxlint src/ --fix",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"version": "bun version-bump.ts && git add manifest.json versions.json"
	},
	"dependencies": {
		"obsidian": "latest",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"yjs": "^13.6.29"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "latest",
		"eslint-plugin-obsidianmd": "0.1.9",
		"oxfmt": "latest",
		"oxlint": "latest"
	}
}
